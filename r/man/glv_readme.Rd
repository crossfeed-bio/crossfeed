\name{glv_readme}
\alias{glv_readme}
\title{The README grownet wrote with these numbers}
\usage{
glv_readme(x, print = TRUE)
}
\arguments{
\item{x}{gLV parameters from \code{\link{grownet_listen}} or \code{\link{grownet_glv}}.}

\item{print}{Set to \code{FALSE} to return the text without printing it.}
}
\value{
The text, invisibly when printed.
}
\description{
Every convention and every caveat in grownet's own words, the same text the downloadable package
carries.
}
